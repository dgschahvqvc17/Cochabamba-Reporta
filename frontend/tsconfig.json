{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    // expo-image-picker y expo-constants (plataformas web) usan tipos DOM
    // (Blob, File, MediaStream…). El base RN no los incluye.
    "lib": ["ESNext", "DOM"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
